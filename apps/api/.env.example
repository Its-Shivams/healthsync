PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthsync?schema=public

JWT_SECRET=healthsync-super-secure-jwt-secret-key-32chars-min
JWT_EXPIRES_IN=7d
COOKIE_NAME=healthsync_session

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=healthsync-documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI Health Assistant Configuration
# Options: 'ollama' (default local inference) or 'gemini' (cloud model inference)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_TIMEOUT_MS=15000

# Google Gemini Cloud Provider (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

EMERGENCY_HELPLINE=112
AUDIT_LOG_ENABLED=true
