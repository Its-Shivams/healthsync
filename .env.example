# HealthSync Environment Configuration Template

# Server & Runtime
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Primary Relational Database (PostgreSQL)
# Note: In environments without a live PostgreSQL instance, the app automatically activates
# a local standalone SQLite fallback (file:./dev.db) without any manual intervention.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthsync?schema=public

# Authentication & Session Security
JWT_SECRET=healthsync-super-secure-jwt-secret-key-32chars-min
JWT_EXPIRES_IN=7d
COOKIE_NAME=healthsync_session

# Object Storage (MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=healthsync-documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI Health Assistant Configuration (Google Gemini Cloud AI primary)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000
GEMINI_API_KEY=


# Emergency Triage Configuration
EMERGENCY_HELPLINE=112

# Security & Audit Log Configuration
AUDIT_LOG_ENABLED=true

