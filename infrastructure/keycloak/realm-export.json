{
  "realm": "healthsync",
  "enabled": true,
  "displayName": "HealthSync Identity & Access Management",
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      { "name": "PATIENT", "description": "Healthcare Consumer / Patient" },
      { "name": "DOCTOR", "description": "Verified Healthcare Practitioner" },
      { "name": "HOSPITAL_ADMIN", "description": "Hospital / Clinic Administrator" },
      { "name": "LAB_TECHNICIAN", "description": "Diagnostic Laboratory Operator" },
      { "name": "PLATFORM_ADMIN", "description": "System Infrastructure Administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "healthsync-api",
      "name": "HealthSync Backend API",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "healthsync-api-secret-key-mock",
      "bearerOnly": true
    },
    {
      "clientId": "healthsync-web",
      "name": "HealthSync Web Application",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"]
    }
  ]
}
